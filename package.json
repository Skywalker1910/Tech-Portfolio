{
  "name": "tech-portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://skywalker1910.github.io/Tech-Portfolio",
  "scripts": {
    "predev": "node scripts/build-coarse-geoip.mjs",
    "prebuild": "node scripts/build-coarse-geoip.mjs",
    "preanalytics:test": "node scripts/build-coarse-geoip.mjs",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run analytics:test && npm run rag:test && npm run projects:test && npm run rag:evaluate && npm run build",
    "projects:test": "tsx --test tests/project-presentation.test.ts",
    "rag:test": "tsx --test tests/rag-retrieval.test.ts tests/rag-admin-evaluation.test.ts",
    "rag:compare": "tsx --env-file-if-exists=.env.local scripts/compare-rag.ts",
    "rag:setup": "tsx --env-file-if-exists=.env.local scripts/setup-rag.ts",
    "rag:index": "tsx --env-file-if-exists=.env.local scripts/index-rag.ts",
    "rag:evaluate": "tsx --env-file-if-exists=.env.local scripts/evaluate-rag.ts",
    "rag:evaluate:s3": "tsx --env-file-if-exists=.env.local scripts/evaluate-rag.ts --s3",
    "content:setup": "tsx --env-file-if-exists=.env.local scripts/setup-content.ts",
    "content:seed": "tsx --env-file-if-exists=.env.local scripts/seed-content.ts",
    "content:sync:profile": "tsx --env-file-if-exists=.env.local scripts/sync-profile-content.ts",
    "content:sync:profile:apply": "tsx --env-file-if-exists=.env.local scripts/sync-profile-content.ts --apply",
    "analytics:purge-city": "tsx --env-file-if-exists=.env.local scripts/purge-analytics-city.ts",
    "analytics:audit": "tsx --env-file-if-exists=.env.local scripts/audit-analytics-history.ts",
    "analytics:test": "tsx --test tests/analytics-privacy.test.ts tests/coarse-geoip.test.ts",
    "build:ghpages": "cross-env NEXT_PUBLIC_GITHUB_PAGES=true next build --turbopack",
    "predeploy": "npm run build:ghpages",
    "deploy": "gh-pages -b gh-pages -d out --dotfiles"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1027.0",
    "@aws-sdk/client-s3vectors": "^3.1110.0",
    "@aws-sdk/lib-dynamodb": "^3.1027.0",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^12.38.0",
    "geoip-lite": "2.0.3",
    "lucide-react": "^1.0.1",
    "next": "^16.2.3",
    "openai": "^7.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "gh-pages": "^6.3.0",
    "null-loader": "^4.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
