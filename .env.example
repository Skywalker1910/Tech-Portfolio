# ─── GitHub API ──────────────────────────────────────────────────────────────
# Recommended in production: increases the GitHub API rate limit from 60 to 5000 req/hr.
# The server retries the public API if a configured token is expired or revoked.
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# ─── AI Chat ────────────────────────────────────────────────────────────────
# Server-side credential used by BB-8 responses and RAG indexing.
OPENAI_API_KEY=

# Optional server-only Admin API key for the private Command Center usage/cost report.
# This is a separate organization Admin API key; never expose it with NEXT_PUBLIC_*.
OPENAI_ADMIN_KEY=

# Recommended with OPENAI_ADMIN_KEY: limits usage and cost reporting to BB-8's
# dedicated OpenAI project. When omitted, the report is organization-wide.
OPENAI_PROJECT_ID=

# Optional: OpenAI model used by BB-8. Terra balances response quality and cost.
OPENAI_CHAT_MODEL=gpt-5.6-terra

# Embedding configuration used by the portfolio RAG index and query pipeline.
# The S3 Vectors index dimension must match this value.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1024

# Enables semantic retrieval after the compatible vector index contains the current corpus.
# When false or unavailable, BB-8 uses the bundled keyword retriever.
RAG_ENABLED=false
RAG_VECTOR_BUCKET=
RAG_VECTOR_INDEX=portfolio-knowledge
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.65

# Optional: URL opened by the "full-screen chat" links.
# Keep /chat for the built-in page, or replace it with a separately hosted chat app.
NEXT_PUBLIC_FULL_CHAT_URL=/chat

# ─── AWS ─────────────────────────────────────────────────────────────────────
# Production uses the Amplify SSR compute role. Explicit credentials are optional
# overrides and should remain unset after role-based access is verified.

APP_AWS_REGION=us-east-1
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# DynamoDB resource names used by the server runtime.
DYNAMODB_CONTACTS_TABLE=portfolio-contacts
DYNAMODB_PORTFOLIO_TABLE=portfolio-content

# Retention targets in days. DynamoDB TTL deletion is asynchronous.
ANALYTICS_MANDATORY_RETENTION_DAYS=90
ANALYTICS_BASIC_RETENTION_DAYS=180
ANALYTICS_ENHANCED_RETENTION_DAYS=180
ANALYTICS_BB8_RETENTION_DAYS=90
CONTACT_RETENTION_DAYS=365

# ─── Contact Admin ────────────────────────────────────────────────────────────
# Secret key to authenticate GET /api/contact requests (view submissions).
# Use any strong random string. Generate one with: openssl rand -hex 32
ADMIN_KEY=
# Optional dedicated HMAC secret for the 8-hour HttpOnly admin session.
# If omitted, ADMIN_KEY is used as the signing secret.
ADMIN_SESSION_SECRET=
